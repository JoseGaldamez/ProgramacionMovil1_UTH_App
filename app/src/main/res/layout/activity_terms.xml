<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/auth_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/home_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingVertical="12dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/terms_title" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/home_text" android:accessibilityHeading="true"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/close_terms" style="@style/Widget.TicketHN.Close" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/terms_close" app:icon="@drawable/ic_close"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <TextView android:id="@+id/terms_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="24dp" android:text="@string/terms_body" android:textSize="16sp" android:textColor="@color/home_text" android:lineSpacingExtra="5dp"/>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/terms_understood" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="24dp" android:layout_marginVertical="12dp" android:text="@string/terms_understood" app:cornerRadius="28dp" app:backgroundTint="@color/ticket_cyan" android:textColor="@color/home_background"/>
</LinearLayout>
