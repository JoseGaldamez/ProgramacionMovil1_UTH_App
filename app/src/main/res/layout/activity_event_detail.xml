<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/home_background">
            <FrameLayout android:id="@+id/detail_header" android:layout_width="match_parent" android:layout_height="292dp">
                <ImageView android:id="@+id/detail_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_featured_shade"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="8dp">
                    <ImageButton android:id="@+id/detail_back" style="@style/Widget.TicketHN.DetailIcon" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/about_back"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/detail_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/home_text"/>
                    <ImageButton android:id="@+id/detail_share" style="@style/Widget.TicketHN.DetailIcon" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_share" android:contentDescription="@string/detail_share"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/detail_event_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:textColor="@color/home_text" android:accessibilityHeading="true"/>
                    <TextView android:id="@+id/detail_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/home_secondary"/>
                    <TextView android:id="@+id/detail_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/home_text"/>
                </LinearLayout>
            </FrameLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
                <TextView android:id="@+id/detail_venue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/home_text" android:accessibilityHeading="true"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="174dp" android:layout_marginTop="10dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/home_surface">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                        <dev.josegaldamez.tickethn_uth.details.MapGestureContainer android:id="@+id/detail_map" android:layout_width="match_parent" android:layout_height="match_parent"/>
                        <LinearLayout android:id="@+id/map_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="30dp" android:background="@color/home_surface">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_location" app:tint="@color/ticket_cyan" android:importantForAccessibility="no"/>
                            <TextView android:id="@+id/map_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:text="@string/detail_map_placeholder" android:textColor="@color/home_secondary" android:textSize="14sp" android:accessibilityLiveRegion="polite"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/open_maps" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:text="@string/detail_open_maps" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/home_background" android:paddingHorizontal="12dp" android:elevation="0dp" android:stateListAnimator="@null" app:backgroundTint="@color/white" app:strokeColor="@color/ticket_cyan" app:strokeWidth="1dp" app:cornerRadius="10dp" app:icon="@drawable/ic_open_external" app:iconTint="@color/home_background" app:iconSize="18dp" app:iconPadding="8dp" app:iconGravity="textEnd"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/detail_location_demo" android:textColor="@color/home_muted" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="10dp" android:text="@string/detail_tiers" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/home_text" android:accessibilityHeading="true"/>
                <RadioGroup android:id="@+id/detail_tiers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/detail_mock_notice" android:textSize="12sp" android:textColor="@color/home_muted"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/home_border"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:background="@color/home_surface">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/bg_search">
            <ImageButton android:id="@+id/quantity_minus" style="@style/Widget.TicketHN.DetailIcon" android:layout_width="40dp" android:layout_height="48dp" android:src="@drawable/ic_minus" android:contentDescription="@string/detail_decrease"/>
            <TextView android:id="@+id/quantity_value" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp" android:textColor="@color/home_text" android:accessibilityLiveRegion="polite"/>
            <ImageButton android:id="@+id/quantity_plus" style="@style/Widget.TicketHN.DetailIcon" android:layout_width="40dp" android:layout_height="48dp" android:src="@drawable/ic_plus" android:contentDescription="@string/detail_increase"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/detail_buy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="12dp" android:text="@string/detail_buy" android:textSize="14sp" app:backgroundTint="@color/ticket_cyan" android:textColor="@color/home_background" app:cornerRadius="28dp" android:elevation="0dp" android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>

