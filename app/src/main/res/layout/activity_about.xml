<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/home_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <ImageButton android:id="@+id/about_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_back" android:tint="@color/home_secondary" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/about_back"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/about_title" android:textColor="@color/home_text" android:textSize="20sp" android:textStyle="bold" android:accessibilityHeading="true"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="20dp" android:paddingBottom="32dp">
            <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no"/>
            <TextView style="@style/TextAppearance.TicketHN.Brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/home_brand" android:accessibilityHeading="true"/>
            <TextView style="@style/TextAppearance.TicketHN.AboutBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/about_intro"/>
            <TextView style="@style/TextAppearance.TicketHN.AboutBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/about_technology"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="28dp" android:background="@color/home_border"/>
            <ImageView android:layout_width="100dp" android:layout_height="56dp" android:layout_marginTop="24dp" android:src="@drawable/uth_logo" android:scaleType="fitCenter" android:contentDescription="@string/uth_description"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/about_team_title" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/home_text" android:accessibilityHeading="true"/>
            <TextView style="@style/TextAppearance.TicketHN.AboutBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/about_team" android:lineSpacingExtra="10dp"/>
            <TextView style="@style/TextAppearance.TicketHN.AboutBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/about_thanks"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/about_contact" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/about_contact" android:textSize="16sp" android:textColor="@color/home_background" app:backgroundTint="@color/ticket_cyan" app:cornerRadius="28dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
